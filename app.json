{
  "expo": {
    "name": "Modo",
    "slug": "modo",
    "version": "0.1.0",
    "scheme": "modo",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.modo.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.modo.app",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "backgroundColor": "#F7F5F2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-web-browser",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F7F5F2"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O Modo usa a câmera para fotografar suas peças e adicioná-las ao armário."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Modo acessa suas fotos para você adicionar peças já fotografadas ao armário."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Modo usa sua localização para considerar o clima do dia na recomendação de look."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
