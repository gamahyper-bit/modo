# Copie para .env.local e preencha.
#
# Só variáveis EXPO_PUBLIC_* chegam ao app — e tudo que chega ao app é público,
# porque o bundle é extraível. A chave do Gemini e a service role do Supabase
# NUNCA entram aqui: elas vivem como secrets das Edge Functions do Supabase.

EXPO_PUBLIC_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="sua-anon-key"
